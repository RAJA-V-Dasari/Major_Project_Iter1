# Environments and build output
.venv/
venv/
__pycache__/
*.egg-info/
build/

# Secrets. The Hugging Face token lives here - never commit it.
.env

# ---------------------------------------------------------------------
# THE data root. Every page, transcription, crop, booklet, handoff, mark
# and report this project produces is a real student's work - names,
# USNs, signatures and handwriting - and all of it lives under data/ (or
# wherever $MP_DATA points; see common/layout.py). This one line is the
# protection: no rule has to know a stage's folder name.
#
# Because data/ is ignored and inside the tree, `git clean -xdf` deletes
# it. Move it aside first, or keep it outside the repo with MP_DATA.
/data/

# ---------------------------------------------------------------------
# Safety nets for folders that older layouts and older instructions put
# student data in. Nothing writes them now, but an old download unzipped
# here, or a teammate following an old note, would - and `git add -A`
# would stage it. Each of these held real pages or transcriptions once.
/dataset/
/dataset_cleaned/
/data_hf/
/handoff/
/handoff1/
/handoff_Pranay/
/answer_keys/
/ground_truth/
**/output/
**/output_*/
**/upload/
**/predictions/
**/ground_truth/
**/crops/
**/annotated/
**/kaggle/
**/scheme_pages/
**/covers/

# Model weights: gigabytes, re-downloadable, and this repo may sit in a
# synced folder (OneDrive) that would upload them.
*.gguf
*.pt
*.safetensors
models/

# Local tool configuration
.claude/
.worklist.json
