# Copy this file to .env (gitignored) and fill it in. Every script reads it
# through common/layout.py; a variable already set in your shell wins.

# Read access to the private Hugging Face repos (prss-majorproject-37).
# huggingface.co -> Settings -> Access Tokens. Never commit it.
HF_TOKEN=

# Optional: keep all student data outside the repo - for example outside a
# synced OneDrive folder. Default: <repo>/data
# MP_DATA=D:\mp-data

# Optional: the default reader, i.e. the folder under data/read/.
# Default: qwen7b (what the Colab notebook names its 7B run)
# MP_ENGINE=all_read

# Optional: mark an existing handoff instead of data/handoff - for example
# the one part 1 shipped in September as handoff1/.
# MPE_HANDOFF=D:\somewhere\handoff1

# Optional: where the three scheme PDFs are. Default: data/schemes
# MPE_SCHEMES=D:\somewhere\answer_keys

# Optional: bearer token for a VLM server (read_pages.py --reader server).
# VLM_API_KEY=

# Optional: a non-default Ollama for the local model tier.
# OLLAMA_HOST=http://localhost:11434
